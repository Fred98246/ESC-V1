	)
	(text "The Rule: N-channel MOSFETs require the Gate voltage to be ~13.3V higher than the Source to turn on.\nLow-Side: The Source is grounded (0V), so supplying 13.3V to the Gate works perfectly.\nHigh-Side: When activated, the Source pin jumps to the 24V battery rail.\nThe Solution: To keep the MOSFET from shutting off, the driver's bootstrap circuit boosts the high-side Gate \nto 37.3V (24V battery + 13.3V drive) so it stays safely above the Source."
		(exclude_from_sim no)
		(at 22.86 237.49 0)
		(effects
			(font
				(size 1.016 1.016)
				(thickness 0.0635)
			)
			(justify left)
		)
		(uuid "20e983c5-7c30-4b6f-bd91-d746c4c5dc32")
	)
